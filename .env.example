# LOCAL DEVELOPMENT: shared Server + Agent configuration.
# Copy to root .env only if it does not exist. Never commit real secrets.
# Both components load root .env; process environment variables take priority.
# Docker/server-only deployment: use server/.env.example instead.

# --- Server ---
ENVIRONMENT=development
AGENT_CLOCK_DRIFT_THRESHOLD_SEC=120
DATABASE_URL=sqlite:///./data/openguard.db
JWT_SECRET=replace-with-at-least-32-random-characters
POLICY_HMAC_SECRET=replace-with-a-random-shared-policy-secret
REPORT_TIMEZONE_OFFSET_MINUTES=420
# Cleanup frequency, NOT the retention age (activity retention is 90 days in code).
RETENTION_INTERVAL_SEC=86400
RETENTION_RETRY_SEC=3600

# --- Agent ---
OGK_SERVER_URL=http://127.0.0.1:8000
# Must equal POLICY_HMAC_SECRET above; replace both with the same real secret.
OGK_POLICY_HMAC_SECRET=replace-with-a-random-shared-policy-secret
OGK_HEARTBEAT_INTERVAL_SEC=60
OGK_REQUEST_TIMEOUT_SEC=10
OGK_USAGE_TICK_SEC=1
# Seconds after an observed sign-in before the agent can lock again; 0 disables the delay.
OGK_RELOCK_DELAY_SEC=5
OGK_VERIFY_TLS=true

# Week 03 agent. DNS is bound to loopback; Windows adapter DNS is never changed automatically.
OGK_APPS_ENABLED=true
OGK_APP_POLL_SEC=2
OGK_DNS_ENABLED=true
OGK_DNS_PORT=53
OGK_DNS_UPSTREAM=1.1.1.1
OGK_EVENT_SYNC_SEC=5
# Match the server REPORT_TIMEZONE_OFFSET_MINUTES (default UTC+7).
OGK_REPORT_TIMEZONE_OFFSET_MINUTES=420
