# Copy this file to .env and replace secrets outside local development.
ENVIRONMENT=development
AGENT_CLOCK_DRIFT_THRESHOLD_SEC=120
DATABASE_URL=sqlite:///./data/openguard.db
JWT_SECRET=replace-with-at-least-32-random-characters
# Server and agent must use the SAME value, otherwise the agent rejects every policy
# ("policy signature verification failed") and enforces nothing.
POLICY_HMAC_SECRET=change-me-shared-policy-secret

# Agent on another machine: the server's LAN address, e.g. http://192.168.1.10:8000
OGK_SERVER_URL=http://127.0.0.1:8000
OGK_POLICY_HMAC_SECRET=change-me-shared-policy-secret
OGK_HEARTBEAT_INTERVAL_SEC=60
OGK_REQUEST_TIMEOUT_SEC=10
OGK_USAGE_TICK_SEC=1
# Seconds after an observed sign-in before the agent can lock again; 0 disables the delay.
OGK_RELOCK_DELAY_SEC=5
OGK_VERIFY_TLS=true

# Week 03 agent. DNS is bound to loopback (127.0.0.1 and ::1).
OGK_APPS_ENABLED=true
OGK_APP_POLL_SEC=2
OGK_DNS_ENABLED=true
OGK_DNS_PORT=53
OGK_DNS_UPSTREAM=1.1.1.1
OGK_EVENT_SYNC_SEC=5
# Match the server REPORT_TIMEZONE_OFFSET_MINUTES (default UTC+7).
OGK_REPORT_TIMEZONE_OFFSET_MINUTES=420

# Week 04 Service. After a reboot without server: provisional (wall clock, never earlier than
# the last trusted time) or strict (lock until a heartbeat verifies the time).
OGK_OFFLINE_CLOCK=provisional
# auto: the Windows Service points adapters at the proxy, blocks direct DNS/DoT in the firewall
# and disables browser DoH; `run` in a console leaves them alone. true/false force it.
OGK_DNS_AUTOCONFIG=auto
# open: restore the adapters' DNS while the proxy is unhealthy; closed: keep DNS blocked.
OGK_DNS_FAILURE_MODE=open
