APP_NAME=OpenGuard Kids Server
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/openguard.db

JWT_SECRET=<jwt-secret-at-least-32-bytes-long>
POLICY_HMAC_SECRET=<policy-hmac-secret>

PARENT_ACCESS_TOKEN_EXPIRE_MINUTES=720
DEVICE_ACCESS_TOKEN_EXPIRE_MINUTES=15
DEVICE_REFRESH_TOKEN_EXPIRE_DAYS=30
ENROLLMENT_CODE_EXPIRE_MINUTES=10

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

WEB_SESSION_EXPIRE_HOURS=12
WEB_COOKIE_SECURE=false

# Agent must use the same policy HMAC secret in the lab environment.
OGK_POLICY_HMAC_SECRET=dev-only-policy-secret
OGK_ENFORCEMENT_TICK_SEC=1
OGK_CLOCK_DRIFT_THRESHOLD_SEC=120