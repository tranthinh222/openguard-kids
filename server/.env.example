# Pass these as process/container environment variables. The app still reads root .env for local development.
ENVIRONMENT=production
DATABASE_URL=sqlite:////data/openguard.db
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
POLICY_HMAC_SECRET=replace-with-a-different-random-secret-at-least-32-characters
WEB_COOKIE_SECURE=true
ALLOWED_HOSTS=["localhost","127.0.0.1","dashboard.example.com"]
ASSET_VERSION=w04
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
# Trust only the actual reverse proxy address, never arbitrary forwarded client headers.
FORWARDED_ALLOW_IPS=127.0.0.1
REPORT_TIMEZONE_OFFSET_MINUTES=420
AGENT_CLOCK_DRIFT_THRESHOLD_SEC=120
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_ENABLED=true
AUTH_REQUESTS_PER_MINUTE=30
API_REQUESTS_PER_MINUTE=600
RETENTION_INTERVAL_SEC=86400
RETENTION_RETRY_SEC=3600
WEBSOCKET_AUTH_INTERVAL_SEC=30
WEBSOCKET_MAX_MESSAGE_BYTES=4096
WEBSOCKET_MESSAGES_PER_MINUTE=120
